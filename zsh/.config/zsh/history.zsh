# ============================================================================
# HISTORY CONFIGURATION
# ============================================================================
# Oh My Zsh ya fija HISTSIZE/SAVEHIST, share_history, extended_history y
# append_history. Aquí solo lo que iguala a history.sh de bash.

setopt hist_ignore_space      # ≈ HISTCONTROL=ignorespace
setopt hist_ignore_all_dups   # ≈ erasedups
